{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "crons": [
    {
      "path": "/api/cron/log-retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/tickets",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/playground",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/reembed",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/recrawl",
      "schedule": "15 2 * * *"
    }
  ]
}
