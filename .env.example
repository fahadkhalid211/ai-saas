# ==============================================================================
# Kortex AI - Enterprise SaaS Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local or .env in production and supply appropriate credentials.

# ------------------------------------------------------------------------------
# Application & Base URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Admin Authentication & Security
# ------------------------------------------------------------------------------
# Master admin passcode used to unlock the management console and sign API requests.
ADMIN_API_KEY=kortex_admin_super_secret_key_change_me_in_production
ADMIN_PASSWORD=

# 32-character secret key used for AES-256 GCM credential encryption (BYOK).
ENCRYPTION_SECRET=kortex-ai-default-encryption-salt-2026

# Secret key required to trigger background cron endpoints (/api/cron/*).
CRON_SECRET=kortex_cron_internal_secret_token

# ------------------------------------------------------------------------------
# Supabase Cloud Database (PostgreSQL & Vector Storage)
# ------------------------------------------------------------------------------
# Required for production persistence on Vercel.
# Create a free project at https://supabase.com and copy your project API credentials.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# AI Engine Providers (BYOK - Bring Your Own Keys)
# ------------------------------------------------------------------------------
# OpenAI API Key (GPT-4o, GPT-4o-mini, o3-mini)
OPENAI_API_KEY=

# Groq API Key (Ultra-low latency Llama-3.3-70b, Mixtral-8x7b)
GROQ_API_KEY=

# Google Gemini API Key (Gemini 2.0 Flash, Gemini 1.5 Pro)
GEMINI_API_KEY=

# DeepSeek API Key (DeepSeek-V3, DeepSeek-R1)
DEEPSEEK_API_KEY=

# Anthropic API Key (Claude 3.5 Sonnet, Claude 3.5 Haiku)
ANTHROPIC_API_KEY=

# Ollama local/remote instance endpoint (e.g. http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# Local Vector Embeddings (Transformers.js ONNX)
# ------------------------------------------------------------------------------
# Default ONNX embedding model runs locally with 0 cloud embedding fees.
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

# ------------------------------------------------------------------------------
# Email Delivery & Notifications (SMTP / Resend)
# ------------------------------------------------------------------------------
# Resend API Key (Transactional emails)
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Standard SMTP Relay Configuration (Alternative to Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=noreply@kortex-ai.com

# ------------------------------------------------------------------------------
# Omnichannel Integrations
# ------------------------------------------------------------------------------
# Meta / WhatsApp Business Cloud API app secret verification
WHATSAPP_APP_SECRET=

# Public Kortex Client SDK Key (Used in template demos)
KORTEX_API_KEY=
