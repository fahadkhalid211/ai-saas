# ==============================================================================
# Crescelo - Enterprise SaaS Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local or .env in production and supply appropriate credentials.

# ------------------------------------------------------------------------------
# Application & Base URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Admin Authentication & Security
# ------------------------------------------------------------------------------
# Master admin passcode used to unlock the management console and sign API requests.
# CRITICAL: Generate a strong 64+ char random string for production.
ADMIN_API_KEY=kortex_admin_super_secret_key_change_me_in_production
# The only e-mail allowed to sign in at /master (also needs ADMIN_API_KEY). Defaults to itsfahad9@gmail.com.
MASTER_ADMIN_EMAIL=itsfahad9@gmail.com
ADMIN_PASSWORD=

# 32-character (or longer) secret key used for AES-256 GCM credential encryption (BYOK).
# CRITICAL: Changing this in production will invalidate existing encrypted API keys!
ENCRYPTION_SECRET=kortex-ai-default-encryption-salt-2026

# Secret key required to trigger background cron endpoints (/api/cron/*).
# Must be passed as Bearer token in the Authorization header.
CRON_SECRET=kortex_cron_internal_secret_token

# Set to 'true' if the app runs behind a reverse proxy (e.g. Nginx, ALB) that overwrites
# client-supplied X-Forwarded-For headers. Leave 'false' if directly exposed or behind Cloudflare/Vercel.
TRUST_PROXY_HEADERS=false

# ------------------------------------------------------------------------------
# Social Login: Google OAuth 2.0
# ------------------------------------------------------------------------------
# 1. Go to Google Cloud Console (https://console.cloud.google.com) -> APIs & Services -> Credentials
# 2. Create an OAuth 2.0 Client ID (Web Application)
# 3. Add Authorized redirect URIs:
#    - Development: http://localhost:3000/api/auth/oauth/google
#    - Production:  https://www.crescelo.com/api/auth/oauth/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Bot Protection: Google reCAPTCHA (v3 recommended or v2)
# ------------------------------------------------------------------------------
# 1. Register your site at https://www.google.com/recaptcha/admin/create
# 2. Select reCAPTCHA v3 or v2 (Checkbox/Invisible)
# 3. Add your domains: localhost, crescelo.com, etc.
# 4. Copy the keys below:
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ------------------------------------------------------------------------------
# Social Login: Sign in with Apple
# ------------------------------------------------------------------------------
# 1. In Apple Developer (https://developer.apple.com/account/resources/identifiers/list/serviceId):
#    - Create a Services ID (e.g., com.crescelo.ai.web)
#    - Configure Return URLs:
#      - Development: http://localhost:3000/api/auth/oauth/apple
#      - Production:  https://www.crescelo.com/api/auth/oauth/apple
# 2. In Keys, create a Sign in with Apple key and download the .p8 private key file.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Alternatively, if using a pre-generated client secret JWT:
APPLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Enterprise SSO (SAML 2.0 / OIDC / Okta / Azure AD / Google Workspace)
# ------------------------------------------------------------------------------
# Option A: OpenID Connect (OIDC) / Okta / Microsoft Entra ID (Azure AD)
SSO_OIDC_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# Option B: SAML 2.0 Identity Provider
SAML_ENTRY_POINT=
SAML_ISSUER=https://www.crescelo.com
SAML_CERT=

# Option C: WorkOS Single Sign-On (Optional)
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# ------------------------------------------------------------------------------
# Supabase Cloud Database (PostgreSQL & Vector Storage)
# ------------------------------------------------------------------------------
# Required for production persistence on Vercel or cloud environments.
# Create a project at https://supabase.com and copy your project API credentials.
NEXT_PUBLIC_SUPABASE_URL=
# Service role key is server-only and bypasses RLS. NEVER expose to the browser!
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Direct PostgreSQL connection string (pooled or session mode)
DATABASE_URL=
POSTGRES_URL=

# Relational mode: when true, high-frequency collections (messages, conversations,
# leads, appointments, notifications, unanswered queries) write to dedicated Postgres
# tables instead of the monolithic JSON blob. Run supabase/schema-relational-v2.sql first!
# Default: false (blob remains authoritative until validated in production).
DB_RELATIONAL_MODE=false

# ------------------------------------------------------------------------------
# Upstash Redis (Optional L2 Serverless Cache Layer)
# ------------------------------------------------------------------------------
# Highly recommended for serverless deployments (Vercel / AWS Lambda) to share cache
# across ephemeral cold-start instances and keep Supabase egress near zero.
# Create a free database at https://console.upstash.com (10,000 commands/day free).
# If omitted, Crescelo automatically falls back to in-memory L1 RAM caching.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# AI Engine Providers (BYOK - Bring Your Own Keys)
# ------------------------------------------------------------------------------
# OpenAI API Key (GPT-4o, GPT-4o-mini, o3-mini)
OPENAI_API_KEY=

# Groq API Key (Ultra-low latency Llama-3.3-70b, Mixtral-8x7b)
GROQ_API_KEY=

# Google Gemini API Key (Gemini 2.0 Flash, Gemini 1.5 Pro)
GEMINI_API_KEY=

# DeepSeek API Key (DeepSeek-V3, DeepSeek-R1)
DEEPSEEK_API_KEY=

# Anthropic API Key (Claude 3.5 Sonnet, Claude 3.5 Haiku)
ANTHROPIC_API_KEY=

# Ollama local/remote instance endpoint (e.g. http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# Local Vector Embeddings (Transformers.js ONNX)
# ------------------------------------------------------------------------------
# Default ONNX embedding model runs locally with 0 cloud embedding fees.
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

# ------------------------------------------------------------------------------
# Email Delivery & Notifications (SMTP / Resend)
# ------------------------------------------------------------------------------
# Resend API Key (Transactional emails)
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Standard SMTP Relay Configuration (Alternative to Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=noreply@crescelo.com

# ------------------------------------------------------------------------------
# Omnichannel Integrations
# ------------------------------------------------------------------------------
# Meta / WhatsApp Business Cloud API app secret verification
WHATSAPP_APP_SECRET=

# Public Crescelo Client SDK Key (Used in template demos)
CRESCELO_API_KEY=

# --- Phone (inbound AI calls) ---
# Shared secret between the voice worker and this app (>= 32 chars). Generate with: openssl rand -hex 32
VOICE_WORKER_SECRET=
# Secret placed in the carrier's webhook URL: https://your-app/api/channels/voice?k=<this>  (>= 24 chars)
VOICE_WEBHOOK_SECRET=
# Public wss:// URL of the voice worker's media-stream endpoint, e.g. wss://voice.example.com/stream
VOICE_STREAM_URL=
# Optional: Telnyx public key (base64) to also accept Telnyx Ed25519 webhook signatures
TELNYX_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# Database transport security (see ops/postgres-harden.md)
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://crescelo_app:LONG_RANDOM_PASSWORD@db-host:5432/postgres?sslmode=require
# PEM of the CA that signed the database's certificate. When set, the app verifies the server.
# DATABASE_SSL_CA=
# Refuse to connect to a remote database without TLS instead of falling back to plain text.
# DATABASE_REQUIRE_TLS=true
# Max connections per server instance (default 3 on Vercel, 10 elsewhere).
# DATABASE_POOL_MAX=3
# Sign in with Apple and enterprise SSO are switched off until they verify provider signatures.

# ------------------------------------------------------------------------------
# System log (master-admin only, see ops/logging.md)
# ------------------------------------------------------------------------------
# LOG_LEVEL=info                 # debug | info | warn | error
# LOG_RETENTION_DAYS=30          # older rows are deleted daily
# LOG_CAPTURE_CONSOLE=true       # also record console.error / console.warn
# LOG_ALERTS=true                # e-mail the master admin on error spikes (needs e-mail sending configured)
# LOG_ALERT_THRESHOLD=10         # errors ...
# LOG_ALERT_WINDOW_MIN=5         # ... within this many minutes
# LOG_ALERT_COOLDOWN_MIN=30      # at most one alert e-mail per this many minutes
# CRON_SECRET=                   # REQUIRED for the daily log clean-up: Vercel sends it as "Authorization: Bearer <secret>"
