# Must be the same value as VOICE_WORKER_SECRET in the app (>= 32 chars).
VOICE_WORKER_SECRET=
# The app's public https URL, no trailing slash.
APP_BASE_URL=https://your-app.example.com
# DNS name pointing at this server, used by Caddy for the TLS certificate.
VOICE_DOMAIN=voice.example.com

# Carrier control (transfer to a person, hang up). Telnyx dashboard: API key and TeXML account SID.
TELNYX_API_KEY=
TELNYX_ACCOUNT_SID=

# Capacity and models
MAX_CONCURRENT_CALLS=4
STT_MODEL=small
STT_COMPUTE=int8
STT_THREADS=4
DEFAULT_VOICE=en_US-lessac-medium
END_SILENCE_MS=550
